# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (MongoDB Atlas or local fallback)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/saranda_safari_resort?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/saranda_safari_resort

# Authentication & Security
JWT_SECRET=your_super_strong_production_jwt_secret_key_minimum_32_chars

# CORS Allowed Origins (Comma-separated for multiple domains, e.g. Vercel + custom domain)
CORS_ORIGIN=https://sarandasafariresort.com,https://www.sarandasafariresort.com,http://localhost:5173
CLIENT_URL=https://sarandasafariresort.com

# Payment Credentials (Optional - if unset, emails route to WhatsApp concierge)
RESORT_UPI_VPA=your_official_resort_upi_vpa@bank

# Transactional Email Service (Resend - Optional)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Saranda Safari Resort <onboarding@resend.dev>
